# Copy to deploy/.env (docker compose reads it automatically from the compose
# file's directory). Every value has a safe DEV default in docker-compose.yml.
# NEVER reuse these values outside a developer machine.

# Images
REGISTRY=ghcr.io/oxoafrica/fms
TAG=dev

# Central database (primary + streaming replica)
PG_USER=fms
PG_PASSWORD=fms-dev-password
PG_DB=fms
PG_REPLICATION_USER=replicator
PG_REPLICATION_PASSWORD=replicator-dev-password
PG_PORT=5432
PG_REPLICA_PORT=5433

# Shared service settings
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
LOG_LEVEL=info
NODE_ENV=production

# ZRA Smart Invoice VSDC (mock in dev)
ZRA_VSDC_URL=http://mock-vsdc:8200
ZRA_TPIN=1000000000
ZRA_BHF_ID=000
ZRA_DEVICE_SERIAL=FMS-DEV-0001
MOCK_VSDC_PORT=8200

# Host ports
HTTP_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Edge profile: station LUS-0001 (values match db/seed/001_demo.sql)
EDGE_PG_PASSWORD=edge-dev-password
EDGE_GATEWAY_KEY=gwLUS001.dev-gateway-key-lus-0001
EDGE_PTS_SECRET=devsecret-lus-0001
CLOUD_INGEST_URL=http://proxy/ingest
EDGE_PTS_PORT=8100
EDGE_UI_PORT=8101
EDGE_PRINTER_MODE=console

# PTS simulator: target (edge gateway jsonPTS listener, or
# http://proxy/ingest/pts for direct mode) and any extra CLI flags.
SIM_URL=http://edge-gateway:8100/jsonPTS
SIM_EXTRA_ARGS=

# Observability
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
