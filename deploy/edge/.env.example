# /opt/fms-edge/.env  (chmod 600, owner root). One file per station gateway.
# Values below are the DEV demo station; production values come from the
# FMS admin console (POST /api/v1/admin/gateways returns the key ONCE).
# Full variable reference: services/edge-gateway/.env.example

EDGE_IMAGE=ghcr.io/oxoafrica/fms/edge-gateway
EDGE_TAG=v0.1.0
EDGE_DATA_DIR=/var/lib/fms-edge
EDGE_BIND_ADDR=0.0.0.0
EDGE_PG_PASSWORD=change-me-long-random

# Identity
STATION_CODE=LUS-0001
STATION_NAME=Zambezi Cairo Road
GATEWAY_CODE=GW-LUS-0001
GATEWAY_KEY=gwLUS001.dev-gateway-key-lus-0001

# Redundancy: always (single unit) | vip (primary/standby behind keepalived VIP)
HA_MODE=always
# HA_VIP=192.168.1.200

# PTS-2 controller (REMOTE SERVER SETTINGS "Secret key")
PTS_ID=003B00265030500420303531
PTS_SECRET=devsecret-lus-0001
# Controller web server, used to push price updates from the cloud
PTS_CONTROL_URL=https://192.168.1.117/jsonPTS
PTS_CONTROL_USER=admin
PTS_CONTROL_PASSWORD=change-me

# Cloud (the gateway appends /ingest/v1/edge/batches)
CLOUD_INGEST_URL=https://fms.example.zm

# ZRA Smart Invoice VSDC (station's own TPIN / branch / device serial)
FISCAL_DRIVER=zra
ZRA_VSDC_URL=https://vsdc.example.zra.org.zm
ZRA_TPIN=1000000000
ZRA_BHF_ID=000
ZRA_DEVICE_SERIAL=FMS-LUS-0001-A

# Printer: console | file | escpos-tcp (PRINTER_HOST/PRINTER_PORT) | escpos-serial (PRINTER_PATH/PRINTER_BAUD)
PRINTER_DRIVER=escpos-tcp
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100
LOG_LEVEL=info
