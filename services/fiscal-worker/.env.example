# ---------------------------------------------------------------- core
DATABASE_URL=postgres://fms:fms@localhost:5432/fms
LOG_LEVEL=info
# Prometheus /metrics, /healthz, /readyz
METRICS_PORT=9464
# Defaults to <hostname>-<pid>; used as fms.jobs.locked_by
# WORKER_ID=fiscal-worker-1

# ---------------------------------------------------------------- job runner
# Comma-separated subset of: fiscalise,rollup,webhook,notify,erb_export (default: all)
# WORKER_KINDS=fiscalise,webhook
WORKER_CONCURRENCY=8
WORKER_BATCH_SIZE=10
WORKER_POLL_INTERVAL_MS=1000
JOB_TIMEOUT_MS=120000
# 'running' jobs whose locked_at is older than this are re-queued (or dead-lettered)
JOB_LEASE_TIMEOUT_MINUTES=10
JOB_LEASE_CHECK_INTERVAL_MS=60000
# Exponential backoff with jitter: base * 2^(attempt-1), capped
JOB_BACKOFF_BASE_MS=5000
JOB_BACKOFF_MAX_MS=3600000
SHUTDOWN_GRACE_MS=30000
DB_POOL_MAX=10

# ---------------------------------------------------------------- scheduler (leader-elected)
SCHEDULER_ENABLED=true
SCHEDULER_TICK_MS=30000
SCHEDULER_LOCK_KEY=727301
SCHEDULER_TIMEZONE=Africa/Lusaka
# Daily rollups + ERB exports for yesterday
SCHEDULER_DAILY_AT=00:15
ERB_EXPORT_DELAY_MINUTES=10
FISCAL_SWEEP_INTERVAL_MS=300000
PARTITIONS_INTERVAL_MS=3600000
# Direct-mode stations: cloud signs sales still pending after N minutes
FISCAL_DIRECT_DELAY_MINUTES=2
# Edge-mode stations: cloud fallback after N minutes unsigned
FISCAL_CLOUD_FALLBACK_MINUTES=60
FISCAL_SWEEP_LOOKBACK_DAYS=30
FISCAL_SWEEP_LIMIT=5000
GATEWAY_OFFLINE_MINUTES=15

# ---------------------------------------------------------------- ZRA Smart Invoice (VSDC)
ZRA_VSDC_URL=http://localhost:8200
ZRA_DEVICE_SERIAL=FMS-CLOUD-001
ZRA_TIMEOUT_MS=15000
# VAT rates in percent per category (tax-inclusive prices). Default A=16
# ZRA_VAT_RATES=A=16,B=16,D=0
# Per seller TPIN:branch VSDC device overrides (JSON)
# ZRA_VSDC_DEVICES={"1000000001:001":{"baseUrl":"http://vsdc-zambezi:8080","deviceSerial":"DVC123","cmcKey":"..."}}
# PTS-2 transactions carry no payment type; used for pmtTyCd
FISCAL_DEFAULT_PAYMENT_TYPE=cash
# Optional digital receipt archive (text receipts via @fms/fiscal-printer file driver)
# RECEIPT_ARCHIVE_DIR=/data/receipts

# ---------------------------------------------------------------- webhooks / exports
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=12
EXPORT_DIR=./exports

# ---------------------------------------------------------------- notifications (optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=alerts@fms.example
# SMS_GATEWAY_URL=https://sms-gateway.example/api/send
# SMS_GATEWAY_TOKEN=
# FCM_PROJECT_ID=
