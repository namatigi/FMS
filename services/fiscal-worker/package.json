{
  "name": "@fms/fiscal-worker",
  "version": "0.1.0",
  "private": true,
  "description": "FMS job worker: cloud ZRA fiscalisation, webhooks, daily roll-ups, ERB exports, notifications and scheduler",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 dist/"
  },
  "dependencies": {
    "@fms/fiscal-printer": "file:../../packages/fiscal-printer",
    "@fms/shared": "file:../../packages/shared",
    "@fms/zra-client": "file:../../packages/zra-client",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
