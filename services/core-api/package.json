{
  "name": "@fms/core-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "openapi": "tsx scripts/gen-openapi.ts",
    "test": "tsx --test --test-concurrency=1 test/api.test.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^5.2.6",
    "@fms/shared": "file:../../packages/shared",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^4.0.2",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
