# core-api configuration
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# Primary (writes) and optional read replica (heavy reads; falls back to primary)
DATABASE_URL=postgres://fms:fms@localhost:5432/fms
DATABASE_URL_RO=
PG_POOL_MAX=20
PG_POOL_RO_MAX=20
# HS256 signing secret shared with analytics/other services (min 16 chars)
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated allowed origins; empty or * = reflect any origin
CORS_ORIGINS=http://localhost:5173
# Per-IP limit on /api/v1 and on login/refresh (requests per minute)
RATE_LIMIT_RPM=1200
LOGIN_RATE_LIMIT_RPM=30
# SSE poll interval
STREAM_POLL_MS=5000
# Apply services/core-api/migrations at startup (advisory-locked)
RUN_MIGRATIONS=true
MFA_ISSUER=Zambia FMS
