# ---------------------------------------------------------------------------
# FMS edge gateway (one per filling station). Copy to .env or /etc/fms/edge-gateway.env
# ---------------------------------------------------------------------------
LOG_LEVEL=info
# Local Postgres on the station mini-PC (schema "edge" is created/migrated on start)
DATABASE_URL=postgres://fms_edge:change-me@localhost:5432/fms_edge

# PTS-2 upload listener (point the PTS-2 REMOTE SERVER SETTINGS here; URI jsonPTS)
EDGE_PTS_HOST=0.0.0.0
EDGE_PTS_PORT=8100
EDGE_PTS_BODY_LIMIT=16777216
# Local admin UI / metrics / health
EDGE_UI_HOST=0.0.0.0
EDGE_UI_PORT=8101
# Optional basic auth for the UI (healthz/readyz/metrics stay open)
EDGE_UI_USER=
EDGE_UI_PASSWORD=

# Station identity (invoice numbers are <STATION_CODE>-P<pump>-<tx>-<yyyyMMddHHmmss Lusaka>)
STATION_CODE=LUS-0001
STATION_NAME=Zambezi Cairo Road
STATION_ADDRESS=Cairo Road, Lusaka
# Optional JSON file: {"station":{...},"fuel_grades":[{"pts_grade_id":1,"name":"Unleaded Petrol",
#   "product_code":"PETROL","zra_item_code":"ZM1NTLTR0000001","zra_item_class_code":null,
#   "zra_item_name":null,"vat_category":"A","vat_rate_pct":16,"price":31.85}],"controllers":[...]}
# Re-read on the cloud "reload_config" command. Default grades = demo seed (db/seed/001_demo.sql).
EDGE_CONFIG_FILE=

# PTS-2 controller(s). Simple form for one controller:
PTS_ID=003B00265030500420303531
PTS_SECRET=devsecret-lus-0001
# Controller web server (jsonPTS) used to push price updates; basic auth (DIP-2 ON)
PTS_CONTROL_URL=http://192.168.1.117/jsonPTS
PTS_CONTROL_USER=admin
PTS_CONTROL_PASSWORD=admin
# Or several controllers as JSON:
# PTS_CONTROLLERS=[{"pts_id":"...","secret":"...","control_url":"http://...","control_user":"admin","control_password":"..."}]
PTS_CONTROLLERS=
# Accept uploads from controllers not configured above (no signature check)
PTS_ALLOW_UNKNOWN=false
PTS_CONTROL_TIMEOUT_MS=10000

# ZRA Smart Invoice VSDC (packages/zra-client). FISCAL_DRIVER=zra|fake|disabled
FISCAL_DRIVER=zra
ZRA_VSDC_URL=http://localhost:8200
ZRA_TPIN=1000000001
ZRA_BHF_ID=000
ZRA_DEVICE_SERIAL=EDGE-LUS-0001
ZRA_TIMEOUT_MS=15000
FISCAL_PAYMENT_TYPE=cash
FISCAL_CONCURRENCY=4
FISCAL_POLL_MS=1000
FISCAL_RETRY_BASE_MS=2000
# exponential backoff cap (5 min)
FISCAL_RETRY_MAX_MS=300000
FISCAL_LEASE_MS=120000

# Receipt printer (packages/fiscal-printer): console | none | file | escpos-tcp | escpos-serial
PRINTER_DRIVER=console
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100
PRINTER_PATH=/dev/ttyUSB0
PRINTER_BAUD=9600
PRINTER_DIR=./receipts

# Cloud sync: POST ${CLOUD_INGEST_URL}/ingest/v1/edge/batches
CLOUD_INGEST_URL=https://fms.example.gov.zm
GATEWAY_CODE=GW-LUS-0001
GATEWAY_KEY=gwLUS001.dev-gateway-key-lus-0001
SYNC_BATCH_MAX_RECORDS=500
SYNC_BATCH_MAX_BYTES=1048576
SYNC_INTERVAL_MS=2000
SYNC_GZIP=true
SYNC_TIMEOUT_MS=30000
SYNC_BACKOFF_BASE_MS=1000
SYNC_BACKOFF_MAX_MS=60000
SYNC_MAX_RETRYABLE_ATTEMPTS=100
HEARTBEAT_INTERVAL_MS=30000
# PTS-2 status arrives every second; forward at most this often per controller
STATUS_SYNC_INTERVAL_MS=60000

# Redundancy: always | vip | file | standby   (see deploy/REDUNDANCY.md)
HA_MODE=always
HA_VIP=192.168.1.10
HA_STATE_FILE=/run/fms-edge/ha-state
HA_CHECK_INTERVAL_MS=2000

# Housekeeping
OUTBOX_RETENTION_DAYS=30
RETENTION_INTERVAL_MS=3600000
GATEWAY_VERSION=0.1.0
