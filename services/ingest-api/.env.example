# ingest-api configuration (all optional except DATABASE_URL)
DATABASE_URL=postgres://postgres@localhost:5432/fms
PORT=8081
HOST=0.0.0.0
LOG_LEVEL=info
# pg pool / timeouts
PG_POOL_MAX=20
PG_STATEMENT_TIMEOUT_MS=15000
PG_IDLE_TIMEOUT_MS=30000
# request limits
BODY_LIMIT_BYTES=5242880
MAX_RECORDS_PER_BATCH=5000
# reference-data cache TTL (controllers, gateways, grades, nozzles, tanks)
CACHE_TTL_MS=60000
# per gateway / per controller token bucket (requests); set RATE_LIMIT_RPS=0 to disable
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
# debounce for rollup jobs (seconds)
ROLLUP_DELAY_S=120
# max piggy-backed edge commands per response
MAX_COMMANDS_PER_RESPONSE=20
# store each EdgeBatch envelope in fms.ingest_raw (source 'edge')
ARCHIVE_EDGE_BATCHES=false
# graceful shutdown deadline
SHUTDOWN_TIMEOUT_MS=15000
