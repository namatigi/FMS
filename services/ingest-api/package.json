{
  "name": "@fms/ingest-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FMS ingest-api: direct jsonPTS uploads from PTS-2 controllers and EdgeBatch uploads from station edge gateways.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/pts.test.ts test/edge.test.ts test/rules.test.ts test/unit.test.ts",
    "load": "tsx scripts/load.ts"
  },
  "dependencies": {
    "@fms/shared": "file:../../packages/shared",
    "fastify": "^5.1.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
