# Use MSW fixtures instead of the real backend
VITE_USE_MOCKS=false
# Base paths (relative = same origin, proxied by Vite dev/preview or nginx)
VITE_API_BASE=/api/v1
VITE_ANALYTICS_BASE=/analytics/v1
# Dev/preview proxy targets
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_ANALYTICS_PROXY_TARGET=http://localhost:8090
