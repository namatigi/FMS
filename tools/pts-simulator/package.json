{
  "name": "@fms/pts-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "PTS-2 forecourt controller simulator (jsonPTS upload client) for FMS integration and load tests",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "pts-simulator": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js",
    "test": "tsc -p tsconfig.json && node --test dist/"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
